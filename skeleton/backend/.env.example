# 백엔드 환경변수 — 실제 값은 .env 에 채우고 커밋하지 않는다 (architecture.md §5, §17)

# DB (psql 로 생성한 데이터베이스)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/__PROJECT_SNAKE__

# JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (콤마 구분)
CORS_ORIGINS=http://localhost:5173

# URL
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# 실행 시각대 (KST 고정)
TZ=Asia/Seoul
