{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
  // SvelteKit 3: 기반 설정은 $app/tsconfig(node_modules/$app, svelte-kit sync 가 생성)가 관리한다.
  // (moduleResolution·verbatimModuleSyntax·isolatedModules 등은 거기서 온다.)
  // #lib 별칭은 package.json "imports" 로 해석된다 — paths/baseUrl 을 직접 쓰지 말 것.
}
